<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- reads the config.json link in RemoteConfig.kt (themes, news) and, only when you tap them, the Google search and Translate tools. Nothing is sent in the background. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- only for the Voice changer tool, asked when you first record -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- lets the app open Android's installer for its own updates (UpdateActivity) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- invisible helper: runs the system speech recogniser -->
        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- invisible helper: gallery picker for the keyboard background -->
        <activity
            android:name=".PickImageActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- downloads and installs a new version of the app -->
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <!-- lock / unlock secret messages, opened from the keyboard -->
        <activity
            android:name=".CryptoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- sticker / GIF studio, opened from the keyboard -->
        <activity
            android:name=".MakerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- WhatsApp "Read more" message maker, opened from the keyboard -->
        <activity
            android:name=".ReadMoreActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Floating YouTube player (Picture-in-Picture): keeps playing when the keyboard closes -->
        <activity
            android:name=".YtPlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|keyboard|uiMode"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- About RIO BOARD page -->
        <activity
            android:name=".AboutActivity"
            android:exported="false" />

        <!-- Voice changer: record, effect, send as an audio file -->
        <activity
            android:name=".VoiceChangerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- QR reader: camera scan (Google code scanner) or from a picture -->
        <activity
            android:name=".QrReadActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <!-- asks Google Play services to download the camera scanner in the background after install -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- WhatsApp status gallery: full size preview with Save / Share / Delete -->
        <activity
            android:name=".StatusActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- serves made stickers/GIFs to other apps (read-only) -->
        <provider
            android:name=".RioFileProvider"
            android:authorities="${applicationId}.stickers"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".RioBoardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
